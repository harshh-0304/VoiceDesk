# ==============================================================================
# VoiceDesk - Environment Configuration
# ==============================================================================
# Copy this file to .env and provide your API keys before running VoiceDesk.
# Example: cp .env.example .env

# Groq API Configuration (Required for Whisper ASR and LLaMA 3 LLM)
# Obtain a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# LLM Model Configuration
# Available options: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
VOICEDESK_MODEL=llama-3.3-70b-versatile

# Text-to-Speech (Edge-TTS) Neural Voice
# Options include:
# - en-US-ChristopherNeural (Male, Authoritative / Deep)
# - en-US-EricNeural (Male, Friendly / Conversational)
# - en-GB-SoniaNeural (Female, British English)
# - en-US-JennyNeural (Female, Natural)
VOICEDESK_VOICE=en-US-ChristopherNeural

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Maximum accepted audio payload size over the WebSocket, in bytes (default 25 MB)
MAX_AUDIO_BYTES=26214400
