# VoiceDesk frontend configuration
# Copy to .env.local and adjust for your backend deployment.

# WebSocket endpoint of the VoiceDesk backend server.
# Default local development URL:
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/audio

# For containerized or custom remote host deployments:
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws/audio
